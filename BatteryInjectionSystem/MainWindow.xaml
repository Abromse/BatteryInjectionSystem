<Window x:Class="BatteryInjectionSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatteryInjectionSystem"
        mc:Ignorable="d"
        Title="电池注液上位机系统" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Day 3 测试：Modbus TCP 通信" FontSize="20" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="IP：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtIp" Text="127.0.0.1" Width="120" Margin="5,0"/>
                <TextBlock Text="端口：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPort" Text="502" Width="60" Margin="5,0"/>
                <Button Content="连接" Click="BtnConnect_Click" Width="80" Margin="10,0"/>
                <Button Content="断开" Click="BtnDisconnect_Click" Width="80" Margin="5,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="从站ID：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSlaveId" Text="1" Width="40" Margin="5,0"/>
                <TextBlock Text="起始地址：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStartAddr" Text="0" Width="50" Margin="5,0"/>
                <TextBlock Text="数量：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtCount" Text="5" Width="40" Margin="5,0"/>
                <Button Content="读取寄存器" Click="BtnRead_Click" Width="100" Margin="10,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtResult" Margin="0,20,0,0" TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
</Window>
