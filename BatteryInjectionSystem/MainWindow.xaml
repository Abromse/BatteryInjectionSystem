        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatteryInjectionSystem"
        xmlns:conv="clr-namespace:BatteryInjectionSystem.Converters"
        mc:Ignorable="d"
        Title="电池注液上位机系统" Height="450" Width="800">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
        <conv:StatusToColorConverter x:Key="StatusToBrush"/>
    </Window.Resources>
