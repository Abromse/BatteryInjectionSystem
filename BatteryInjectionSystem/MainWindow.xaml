            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="从站ID：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSlaveId" Text="1" Width="40" Margin="5,0"/>
                <TextBlock Text="起始地址：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStartAddr" Text="0" Width="50" Margin="5,0"/>
