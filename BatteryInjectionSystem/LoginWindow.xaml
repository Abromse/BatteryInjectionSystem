<Window x:Class="BatteryInjectionSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatteryInjectionSystem"
        mc:Ignorable="d"
        xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="LoginWindow" Height="450" Width="500">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1ABC9C"/>
        <Style TargetType="Button" x:Key ="RoundButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="电池注液登录系统" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28" FontWeight="Black" Margin="0,10,0,0"/>
        <TextBlock Grid.Row="1" Text="账号" FontSize="14" Margin="130,10,0,10"/>
        <Border Grid.Row="2" CornerRadius="4" BorderThickness="1" Margin="0,0,0,20" BorderBrush="#D0D3D9" Background="White" Width="260">
            <TextBox x:Name="usertext" Height="40" FontSize="14" Padding="10,0" BorderThickness="0" Width="260"/>
        </Border>
        
        <TextBlock Grid.Row="3" Text="密码" FontSize="14" Margin="130,10,0,10"/>
        <Grid Grid.Row="4" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="txtBorder" CornerRadius="4" BorderThickness="1" Margin="60,0,0,20" BorderBrush="#D0D3D9" Background="White" Width="260">
                <TextBox x:Name="pwdtext"  Height="40" FontSize="14" Padding="10,0" BorderThickness="0" Width="260"/>
            </Border>
            <Border x:Name="pwdBorder" Visibility="Collapsed" CornerRadius="4" BorderThickness="1" Margin="60,0,0,20" BorderBrush="#D0D3D9" Background="White" Width="260">
                <PasswordBox x:Name="pwdBox" Visibility="Collapsed" Height="40" FontSize="14" Padding="10,0" BorderThickness="0" Width="260"/>
            </Border>
            <Button x:Name="TogglePassword" Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Center" 
                    Click="TogglePasswordVisibility" Margin="10,0,0,20" Background="Transparent" Cursor="Hand" BorderThickness="0">
                <material:PackIcon x:Name="EyeIcon" Kind="EyeOff" Background="Transparent"/>
            </Button>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="登录" Click="Login" Margin="0,0,20,0" Style="{StaticResource RoundButton}"/>
            <Button Content="退出" Click="Exit" Margin="0,0,20,0" Style="{StaticResource RoundButton}"/>
            <Button Content="游客登录" Click="GuestLogin" Style="{StaticResource RoundButton}"/>
        </StackPanel>
    </Grid>
</Window>
